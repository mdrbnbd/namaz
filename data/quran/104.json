{"n":104,"g":6180,"a":[["وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","প্রত্যেক পশ্চাতে ও সম্মুখে পরনিন্দাকারীর দুর্ভোগ,",0],["ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","যে অর্থ সঞ্চিত করে ও গণনা করে",0],["يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","সে মনে করে যে, তার অর্থ চিরকাল তার সাথে থাকবে!",0],["كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","কখনও না, সে অবশ্যই নিক্ষিপ্ত হবে পিষ্টকারীর মধ্যে।",0],["وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","আপনি কি জানেন, পিষ্টকারী কি?",0],["نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","এটা আল্লাহর প্রজ্জ্বলিত অগ্নি,",0],["ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","যা হৃদয় পর্যন্ত পৌছবে।",0],["إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","এতে তাদেরকে বেঁধে দেয়া হবে,",0],["فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","লম্বা লম্বা খুঁটিতে।",0]]}